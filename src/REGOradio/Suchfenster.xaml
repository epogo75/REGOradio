<Window x:Class="REGOradio.Suchfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sender suchen" Height="760" Width="900"
        Background="{DynamicResource Grund}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="Kopfzeile" Style="{StaticResource Ueberschrift}"
               Text="Sender suchen" />

    <!-- Suchzeile. Der Finger tippt ins Feld, Windows blendet bei Toucheingabe
         seine Bildschirmtastatur ein – deshalb hier keine eigene. -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Suchfeld" Grid.Column="0" Style="{StaticResource Eingabe}"
               KeyDown="SuchfeldTaste" />
      <Button Grid.Column="1" Style="{StaticResource Haupttaste}" Content="Suchen"
              Click="Suchen" Margin="12,0,0,0" MinWidth="170" />
    </Grid>

    <!-- Treffer. Große Zeilen: Ein Antippen spielt an, der Knopf daneben legt
         auf die Taste. Reinhören und Behalten sind zwei Entscheidungen. -->
    <ListBox x:Name="Trefferliste" Grid.Row="2" Margin="0,16,0,0"
             Background="{DynamicResource Flaeche}"
             BorderBrush="{DynamicResource Linie}" BorderThickness="1"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="14,12" />
          <Setter Property="MinHeight" Value="84" />
          <Setter Property="Foreground" Value="{DynamicResource Tinte}" />
          <!-- Eigene Vorlage ohne das Systemblau der Auswahl: Ein Antippen
               spielt ohnehin an, eine markierte Zeile braucht es nicht. -->
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Rahmen" Padding="{TemplateBinding Padding}" Background="Transparent"
                        BorderBrush="{DynamicResource Linie}" BorderThickness="0,0,0,1">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Rahmen" Property="Background" Value="{DynamicResource Flaeche2}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <TextBlock Grid.Row="2" x:Name="Hinweis" Style="{StaticResource Zeile}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="HierKnopf" Style="{StaticResource Taste}" Content="Sender in Deutschland"
              Click="HierSuchen" Margin="0,0,12,0" />
      <Button Style="{StaticResource Taste}" Content="Abbrechen" Click="Abbrechen" MinWidth="160" />
    </StackPanel>
  </Grid>
</Window>
