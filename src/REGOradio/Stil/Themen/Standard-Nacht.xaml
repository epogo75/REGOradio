<!--
  Standard, Nacht. Gedämpft statt umgedreht: oft das einzige Licht im Raum.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#0E0F10" />
  <SolidColorBrush x:Key="Flaeche" Color="#17191B" />
  <SolidColorBrush x:Key="Flaeche2" Color="#1F2225" />
  <SolidColorBrush x:Key="Linie" Color="#2C3034" />
  <SolidColorBrush x:Key="LinieStark" Color="#3E4449" />
  <SolidColorBrush x:Key="Tinte" Color="#D8D4CC" />
  <SolidColorBrush x:Key="Tinte2" Color="#9A958B" />
  <SolidColorBrush x:Key="Tinte3" Color="#6E6A62" />
  <SolidColorBrush x:Key="Akzent" Color="#5FA790" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#1B2A26" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#0E0F10" />
  <SolidColorBrush x:Key="Warnung" Color="#C9765E" />

  <!-- Kein Leuchten: Das bleibt Neon vorbehalten. -->
  <x:Null x:Key="Leuchten" />

  <!-- Seit Bau 26 (Thema REGO): Schrift, Hintergrund und Schriftzug sind
       Schlüssel der Tafel. Dieses Thema bleibt, wie es war: Segoe UI, glatter
       Grund, „radio" im Akzent, keine Bausteine im Kopf. -->
  <FontFamily x:Key="Schrift">Segoe UI Variable Display, Segoe UI</FontFamily>
  <SolidColorBrush x:Key="Hintergrund" Color="#0E0F10" />
  <SolidColorBrush x:Key="Schriftzugfarbe" Color="#5FA790" />
  <FontWeight x:Key="SchriftzugREGO">Light</FontWeight>
  <FontWeight x:Key="SchriftzugRadio">Bold</FontWeight>
  <Visibility x:Key="Bausteine">Collapsed</Visibility>

</ResourceDictionary>
