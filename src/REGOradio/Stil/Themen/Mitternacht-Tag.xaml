<!--
  Mitternacht, Tag. Kühles Grau-Blau mit Kobalt.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#EEF1F5" />
  <SolidColorBrush x:Key="Flaeche" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Flaeche2" Color="#E2E7EE" />
  <SolidColorBrush x:Key="Linie" Color="#CFD6E0" />
  <SolidColorBrush x:Key="LinieStark" Color="#AEB8C6" />
  <SolidColorBrush x:Key="Tinte" Color="#121821" />
  <SolidColorBrush x:Key="Tinte2" Color="#4A5566" />
  <SolidColorBrush x:Key="Tinte3" Color="#5E6A7B" />
  <SolidColorBrush x:Key="Akzent" Color="#2451B8" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#DDE6F8" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Warnung" Color="#B0342A" />

  <!-- Kein Leuchten: Das bleibt Neon vorbehalten. -->
  <x:Null x:Key="Leuchten" />

</ResourceDictionary>
