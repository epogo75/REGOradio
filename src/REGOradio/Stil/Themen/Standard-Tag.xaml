<!--
  Standard, Tag. Hell, aber nicht weiß: Reines Weiß ist abends im Hotelzimmer zu viel.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#F4F2EE" />
  <SolidColorBrush x:Key="Flaeche" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Flaeche2" Color="#EAE7E1" />
  <SolidColorBrush x:Key="Linie" Color="#D6D2CA" />
  <SolidColorBrush x:Key="LinieStark" Color="#B8B2A7" />
  <SolidColorBrush x:Key="Tinte" Color="#1C1B19" />
  <SolidColorBrush x:Key="Tinte2" Color="#565249" />
  <SolidColorBrush x:Key="Tinte3" Color="#847E71" />
  <SolidColorBrush x:Key="Akzent" Color="#1F6F5C" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#DCEBE5" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Warnung" Color="#9A3B26" />

  <!-- Kein Leuchten: Das bleibt Neon vorbehalten. -->
  <x:Null x:Key="Leuchten" />

</ResourceDictionary>
