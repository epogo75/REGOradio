<!--
  Neon Grün, Tag. Zurückhaltend: helles Graugrün mit sattem Giftgrün. Neon ist fürs Dunkle gemacht; tagsüber leuchtet nichts, damit „Automatisch“ nicht blendet.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#F0F5F2" />
  <SolidColorBrush x:Key="Flaeche" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Flaeche2" Color="#E1ECE6" />
  <SolidColorBrush x:Key="Linie" Color="#CFDFD6" />
  <SolidColorBrush x:Key="LinieStark" Color="#A7C4B4" />
  <SolidColorBrush x:Key="Tinte" Color="#0F1A14" />
  <SolidColorBrush x:Key="Tinte2" Color="#3F5A4B" />
  <SolidColorBrush x:Key="Tinte3" Color="#56705F" />
  <SolidColorBrush x:Key="Akzent" Color="#3F8A00" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#E4F5CC" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Warnung" Color="#B0342A" />

  <!-- Kein Leuchten: Das bleibt Neon vorbehalten. -->
  <x:Null x:Key="Leuchten" />

</ResourceDictionary>
