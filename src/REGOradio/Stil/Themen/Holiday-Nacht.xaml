<!--
  Holiday, Nacht. Anthrazit mit Bernstein.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#121315" />
  <SolidColorBrush x:Key="Flaeche" Color="#1D1F22" />
  <SolidColorBrush x:Key="Flaeche2" Color="#26292D" />
  <SolidColorBrush x:Key="Linie" Color="#34383D" />
  <SolidColorBrush x:Key="LinieStark" Color="#4A4F56" />
  <SolidColorBrush x:Key="Tinte" Color="#F0EDE6" />
  <SolidColorBrush x:Key="Tinte2" Color="#A39F95" />
  <SolidColorBrush x:Key="Tinte3" Color="#8A867D" />
  <SolidColorBrush x:Key="Akzent" Color="#F2A24A" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#3A2812" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#1A1206" />
  <SolidColorBrush x:Key="Warnung" Color="#EE7A6E" />

  <!-- Kein Leuchten: Das bleibt Neon vorbehalten. -->
  <x:Null x:Key="Leuchten" />

</ResourceDictionary>
