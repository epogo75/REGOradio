<!--
  REGO, Nacht (Bau 26). Der Stil der Familie – regotools.de und REGOglt:
  Nachtblau statt Schwarz, Karten in #161B2E, Minze als Akzent, „radio" im
  Schriftzug violett, die Schrift Outfit und die Leuchtflecken der Webseite
  im Hintergrund. Die Vorlage steht in regotools/seite/stil.css.

  Alle Tafeln unter Stil/Themen haben dieselben Schlüssel – nur so lässt sich
  umschalten, ohne die Oberfläche anzufassen. `ThemenPruefung` wacht darüber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Grund" Color="#0A0C14" />
  <SolidColorBrush x:Key="Flaeche" Color="#161B2E" />
  <SolidColorBrush x:Key="Flaeche2" Color="#1E2440" />
  <SolidColorBrush x:Key="Linie" Color="#262D45" />
  <SolidColorBrush x:Key="LinieStark" Color="#38426A" />
  <SolidColorBrush x:Key="Tinte" Color="#F1F3F9" />
  <SolidColorBrush x:Key="Tinte2" Color="#A3A9BB" />
  <SolidColorBrush x:Key="Tinte3" Color="#8F98B5" />
  <SolidColorBrush x:Key="Akzent" Color="#00D9A3" />
  <SolidColorBrush x:Key="AkzentWeich" Color="#0B2E28" />
  <SolidColorBrush x:Key="AkzentTinte" Color="#062A20" />
  <SolidColorBrush x:Key="Warnung" Color="#FF6B6B" />

  <!-- Ein leiser Schein um die laufende Taste – die Webseite leuchtet auch,
       aber gedämpfter als Neon. -->
  <DropShadowEffect x:Key="Leuchten" Color="#00D9A3" ShadowDepth="0" BlurRadius="24" Opacity="0.55" />

  <!-- Outfit (SIL OFL 1.1), feste Schnitte Light/Regular/SemiBold/ExtraBold
       aus dem Repo des Herausgebers, eingebettet unter Schriften/. WPF kann
       weder woff2 noch Variablen-Achsen – deshalb nicht die Datei der
       Webseite. -->
  <FontFamily x:Key="Schrift">pack://application:,,,/Schriften/#Outfit</FontFamily>

  <!-- Die Leuchtflecken der Webseite (body::before): Minze oben links,
       Violett oben rechts, Koralle unten rechts, Gelb unten links. -->
  <DrawingBrush x:Key="Hintergrund" Stretch="Fill">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0A0C14">
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.20,0.24" GradientOrigin="0.20,0.24" RadiusX="0.42" RadiusY="0.55">
              <GradientStop Color="#3300D9A3" Offset="0" />
              <GradientStop Color="#0000D9A3" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.82,0.28" GradientOrigin="0.82,0.28" RadiusX="0.45" RadiusY="0.6">
              <GradientStop Color="#477C5CFF" Offset="0" />
              <GradientStop Color="#007C5CFF" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.70,0.86" GradientOrigin="0.70,0.86" RadiusX="0.4" RadiusY="0.5">
              <GradientStop Color="#24FF6B6B" Offset="0" />
              <GradientStop Color="#00FF6B6B" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.24,0.80" GradientOrigin="0.24,0.80" RadiusX="0.38" RadiusY="0.48">
              <GradientStop Color="#1AFFC93C" Offset="0" />
              <GradientStop Color="#00FFC93C" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Wie das Wortbild auf regotools.de: „REGO" und „radio" beide kräftig,
       „radio" violett. -->
  <SolidColorBrush x:Key="Schriftzugfarbe" Color="#7C5CFF" />
  <FontWeight x:Key="SchriftzugREGO">ExtraBold</FontWeight>
  <FontWeight x:Key="SchriftzugRadio">ExtraBold</FontWeight>
  <Visibility x:Key="Bausteine">Visible</Visibility>

</ResourceDictionary>
